@page
@model Huia.AspNetCore.Areas.Identity.Pages.Account.ForgotPasswordModel

@if (Model.Submitted)
{
    <p data-testid="forgot-sent">@Localizer["ForgotPassword.Sent"]</p>
    <div class="huia-links">
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Register.HaveAccount"]</a>
    </div>
}
else
{
    <p class="huia-muted">@Localizer["ForgotPassword.Intro"]</p>
    <form class="form" method="post" asp-route-returnUrl="@Model.ReturnUrl" data-testid="forgot-form">
        <div class="field">
            <label class="label" asp-for="Email">@Localizer["Common.Email"]</label>
            <input class="input" asp-for="Email" type="email" autocomplete="email" autofocus />
        </div>
        <button class="btn w-full" type="submit">@Localizer["ForgotPassword.Submit"]</button>
    </form>
    <div class="huia-links">
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Register.HaveAccount"]</a>
    </div>
}
