{
  "name": "huia-nuxt",
  "version": "0.1.0",
  "description": "First-party Nuxt 4 OIDC/OAuth2 (PKCE + PAR) authentication module for the Huia identity provider",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayman-Elfaki/Huia",
    "directory": "src/nuxt"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "npm run dev:prepare && nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.13.0",
    "iron-webcrypto": "^1.2.1",
    "openid-client": "^6.1.0",
    "uncrypto": "^0.1.3"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "^22.10.0",
    "jose": "^5.10.0",
    "nuxt": "^4.0.0",
    "typescript": "~5.9.3",
    "unstorage": "^1.12.0",
    "vitest": "^4.0.2",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
