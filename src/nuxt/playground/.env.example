# Copy to .env for `npm run dev`. Node's undici rejects the ASP.NET Core dev certificate,
# which also blocks huia-auth-nuxt's OIDC discovery of https://localhost:5310.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Point at a running Huia tenant (defaults bake in https://localhost:5310 / tenant "todo").
# NUXT_HUIA_AUTH_HUIA_BASE_URL=https://localhost:5310
# NUXT_HUIA_AUTH_HUIA_TENANT=todo
# NUXT_HUIA_AUTH_CLIENT_ID=todo-app
# NUXT_HUIA_AUTH_CLIENT_SECRET=todo-app-secret
# NUXT_HUIA_AUTH_SESSION_PASSWORD=at-least-32-characters-long-please-000
