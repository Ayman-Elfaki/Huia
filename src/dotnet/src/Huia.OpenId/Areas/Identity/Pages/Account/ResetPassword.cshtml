@page
@model Huia.OpenId.Areas.Identity.Pages.Account.ResetPasswordModel

@if (Model.Done)
{
    <p data-testid="reset-done">@Localizer["ForgotPassword.Sent"]</p>
    <div class="huia-links">
        <a asp-page="./Login">@Localizer["Common.SignIn"]</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-destructive" role="alert">@Model.ErrorMessage</div>
    }
    <form class="form" method="post" data-testid="reset-form">
        <input type="hidden" asp-for="Input.UserId" />
        <input type="hidden" asp-for="Input.Code" />
        <div class="field">
            <label class="label" asp-for="Input.Password">@Localizer["Common.Password"]</label>
            <input class="input" asp-for="Input.Password" type="password" autocomplete="new-password" autofocus />
        </div>
        <div class="field">
            <label class="label" asp-for="Input.ConfirmPassword">@Localizer["Register.ConfirmPassword"]</label>
            <input class="input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        </div>
        <button class="btn w-full" type="submit">@Localizer["ForgotPassword.Submit"]</button>
    </form>
}
