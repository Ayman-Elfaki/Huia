@page
@model Huia.OpenId.Areas.Identity.Pages.Account.DeviceVerificationModel

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-destructive" role="alert">@Model.ErrorMessage</div>
}

<p class="huia-muted">@Localizer["DeviceVerification.Intro"]</p>

<form class="form" method="post" action="@(Model.PathBase)/connect/verify" data-testid="device-verify-form">
    @Html.AntiForgeryToken()
    <div class="field">
        <label class="label" for="user_code">@Localizer["DeviceVerification.CodeLabel"]</label>
        <input id="user_code" name="user_code" class="input" value="@Model.UserCode" autocomplete="one-time-code"
               autocapitalize="characters" autofocus required />
    </div>
    <div class="flex gap-2">
        <button class="btn flex-1" type="submit" name="submit.accept" value="accept" data-testid="device-verify-accept">
            @Localizer["DeviceVerification.Approve"]
        </button>
        <button class="btn-outline flex-1" type="submit" name="submit.deny" value="deny" data-testid="device-verify-deny">
            @Localizer["DeviceVerification.Deny"]
        </button>
    </div>
</form>
