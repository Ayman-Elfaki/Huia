@model Huia.AspNetCore.Areas.Identity.Pages.Account.LoginModel

<p class="huia-subtitle" data-testid="login-email-description">@Localizer["Login.EmailDescription"]</p>

<form class="form" method="post" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" data-testid="login-form">
    <div class="field">
        <label class="label" asp-for="Input.Email">@Localizer["Common.Email"]</label>
        <input class="input" asp-for="Input.Email" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="huia-muted"></span>
    </div>
    <div class="field">
        <label class="label" asp-for="Input.Password">@Localizer["Common.Password"]</label>
        <input class="input" asp-for="Input.Password" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="huia-muted"></span>
    </div>
    <label class="flex items-center gap-2 text-sm">
        <input asp-for="Input.RememberMe" type="checkbox" class="size-4 rounded border-input" />
        <span>@Localizer["Login.RememberMe"]</span>
    </label>
    <button class="btn w-full" type="submit" data-testid="login-submit">@Localizer["Common.SignIn"]</button>
</form>
