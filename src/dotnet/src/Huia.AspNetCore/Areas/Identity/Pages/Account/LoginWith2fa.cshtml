@page
@model Huia.AspNetCore.Areas.Identity.Pages.Account.LoginWith2faModel

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-destructive" role="alert" data-testid="twofactor-error">@Model.ErrorMessage</div>
}

<p class="huia-subtitle">@Localizer["LoginWith2fa.Intro"]</p>

<div class="huia-passkey" data-huia-passkey data-endpoint="@(Model.PathBase)/identity/account/passkey"
     data-mode="2fa" data-flow="@Model.Flow" data-remember-machine-selector="#huia-remember-machine">
    @Html.AntiForgeryToken()
    <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" id="huia-remember-machine" class="size-4 rounded border-input" />
        <span>@Localizer["LoginWith2fa.RememberMachine"]</span>
    </label>
    <button type="button" class="btn w-full" data-huia-passkey-2fa data-testid="twofactor-passkey">
        @Localizer["LoginWith2fa.UsePasskey"]
    </button>
    <p class="huia-muted huia-passkey-error" role="alert" data-huia-passkey-error hidden></p>
</div>

<details class="huia-recovery">
    <summary>@Localizer["LoginWith2fa.UseRecoveryCode"]</summary>
    <form class="form" method="post" asp-page-handler="RecoveryCode" data-testid="recovery-code-form">
        <input type="hidden" asp-for="Flow" />
        <input type="hidden" asp-for="RememberMe" />
        <div class="field">
            <label class="label" asp-for="Input.RecoveryCode">@Localizer["LoginWith2fa.RecoveryCode"]</label>
            <input class="input" asp-for="Input.RecoveryCode" autocomplete="one-time-code" autocapitalize="none" />
        </div>
        <button class="btn-outline w-full" type="submit" data-testid="recovery-code-submit">@Localizer["LoginWith2fa.Verify"]</button>
    </form>
</details>

@section Scripts {
    <script src="@(Model.PathBase)/_content/Huia.AspNetCore/js/passkey.js" nonce="@CspNonce.Value" defer></script>
}
