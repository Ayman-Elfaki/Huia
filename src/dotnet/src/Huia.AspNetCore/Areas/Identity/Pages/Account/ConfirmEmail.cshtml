@page
@model Huia.AspNetCore.Areas.Identity.Pages.Account.ConfirmEmailModel

@if (Model.Confirmed)
{
    <p data-testid="email-confirmed">@Localizer["RegisterConfirmation.Body"]</p>
}
else
{
    <div class="alert alert-destructive" role="alert">@Localizer["Error.Message"]</div>
}

@if (!string.IsNullOrEmpty(Model.ClientHomeUrl))
{
    <div class="huia-links">
        <a href="@Model.ClientHomeUrl" data-testid="confirm-email-home">@string.Format(Localizer["Common.BackToApp"].Value, Model.DisplayName)</a>
    </div>
}
