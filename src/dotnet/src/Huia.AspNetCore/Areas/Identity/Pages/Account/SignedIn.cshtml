@page
@model Huia.AspNetCore.Areas.Identity.Pages.Account.SignedInModel

<p class="huia-muted" data-testid="signed-in">
    @if (!string.IsNullOrEmpty(Model.UserName))
    {
        @string.Format(Localizer["SignedIn.BodyNamed"].Value, Model.UserName)
    }
    else
    {
        @Localizer["SignedIn.Body"]
    }
</p>

@if (!string.IsNullOrEmpty(Model.ClientHomeUrl))
{
    <a class="btn w-full" href="@Model.ClientHomeUrl" data-testid="signed-in-continue">@string.Format(Localizer["SignedIn.Continue"].Value, Model.DisplayName)</a>
}

@if (Model.IsPasskeyLoginEnabled)
{
    <a class="huia-linkbtn" asp-page="./Passkeys" data-testid="signed-in-passkeys">@Localizer["Passkey.ManageLink"]</a>
}

<form method="post" asp-page="./Logout">
    <button class="btn-outline w-full" type="submit" data-testid="signed-in-sign-out">@Localizer["SignedIn.SignOut"]</button>
</form>
