# Copy to .env for `npm run dev`. Node's undici rejects the ASP.NET Core dev certificate,
# which also blocks nuxt-huia-headless's requests to the Shop.Api backend.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Point at a running Huia.Headless-backed API (defaults bake in https://localhost:5340).
# NUXT_HUIA_HEADLESS_BASE_URL=https://localhost:5340
# NUXT_HUIA_HEADLESS_SESSION_PASSWORD=at-least-32-characters-long-please-000
