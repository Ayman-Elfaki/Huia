{
  "name": "@huia/tanstack-start-headless",
  "version": "1.0.0-alpha.17",
  "description": "TanStack Start pure JSON authentication library for Huia.Headless identity provider",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayman-Elfaki/Huia.git",
