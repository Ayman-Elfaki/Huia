      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "huia-auth-core": "file:../../shared/huia-auth-core",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
