@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = Localizer["ConfirmYourEmailTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["ConfirmYourEmailTitle"]</h2>
        <p>@Localizer["ConfirmationLinkSentMessage", Model.Email]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn huia-full-width" data-variant="outline">@Localizer["BackToSignInLink"]</a>
    </section>
</div>
