@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["CheckYourEmailTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["CheckYourEmailTitle"]</h2>
        <p>@Localizer["ForgotPasswordConfirmationMessage"]</p>
    </header>
    <section>
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn huia-full-width" data-variant="outline">@Localizer["BackToSignInLink"]</a>
    </section>
</div>
