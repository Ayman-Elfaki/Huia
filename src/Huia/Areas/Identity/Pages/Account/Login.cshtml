@page
@model LoginModel
@{
    ViewData["Title"] = Localizer["SignInTitle"].Value;
    ViewData["ReactToSignIn"] = true;
}

<div class="card">
    <header>
        <h2>@Localizer["SignInTitle"]</h2>
        <p>@Localizer["SignInSubtitle"]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <form method="post" class="huia-field-group" novalidate>
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="huia-validation-summary" role="alert"></div>
            @if (Model.ExternalLoginError is not null)
            {
                <div class="huia-validation-summary" role="alert">@Model.ExternalLoginError</div>
            }

            <div role="group" class="field">
                <label asp-for="Input.Email">@Localizer["EmailLabel"]</label>
                <input asp-for="Input.Email" autocomplete="username" placeholder="email@example.com" />
                <span asp-validation-for="Input.Email" role="alert"></span>
            </div>

            <div role="group" class="field">
                <label asp-for="Input.Password">@Localizer["PasswordLabel"]</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" role="alert"></span>
            </div>

            <div role="group" class="field" data-orientation="horizontal">
                <input asp-for="Input.RememberMe" type="checkbox" role="switch" class="input" />
                <label asp-for="Input.RememberMe">@Localizer["RememberMeLabel"]</label>
            </div>

            <div class="huia-actions">
                <button type="submit" class="btn huia-full-width">@Localizer["SignInButton"]</button>
            </div>
        </form>

        @if (Model.ExternalLogins.Count > 0)
        {
            <div class="huia-field-group">
                @foreach (var scheme in Model.ExternalLogins)
                {
                    <form method="post" asp-page="./ExternalLogin" asp-route-provider="@scheme.Name" asp-route-returnUrl="@Model.ReturnUrl">
                        <button type="submit" class="btn huia-full-width" data-variant="outline">@scheme.DisplayName</button>
                    </form>
                }
            </div>
        }

        <div class="huia-footer-links">
            <a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl" data-variant="link" class="btn" data-size="sm">@Localizer["ForgotPasswordLink"]</a>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" data-variant="link" class="btn" data-size="sm">@Localizer["CreateAccountLink"]</a>
        </div>
    </section>
</div>
