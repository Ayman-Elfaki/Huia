@page
@model LoginModel
@{
    ViewData["Title"] = Localizer["SignInTitle"].Value;
    ViewData["ReactToSignIn"] = true;
    var hybrid = Model.ShowEmailPasswordTab && Model.ShowPasswordlessTab;
}

@if (hybrid)
{
    @* Basecoat's tabs script resolves each panel via the tab's aria-controls id (a plain
       document.getElementById lookup, not a DOM-nesting requirement), so the tablist can live outside
       .card while the panels it drives stay inside — only .tabs>[role=tablist] needs to be intact for
       Basecoat's own styling/init to find it. *@
    <div class="tabs huia-login-tabs" id="huia-login-tabs">
        <nav role="tablist" aria-orientation="horizontal" aria-label="@Localizer["SignInMethodLabel"]">
            <button type="button" role="tab" id="huia-tab-password" aria-controls="huia-tab-panel-password" aria-selected="@(Model.PreferPhoneTab ? "false" : "true")" tabindex="@(Model.PreferPhoneTab ? "-1" : "0")">@Localizer["EmailPasswordTabLabel"]</button>
            <button type="button" role="tab" id="huia-tab-phone" aria-controls="huia-tab-panel-phone" aria-selected="@(Model.PreferPhoneTab ? "true" : "false")" tabindex="@(Model.PreferPhoneTab ? "0" : "-1")">@Localizer["PhoneTabLabel"]</button>
        </nav>
    </div>
}

<div class="card">
    <header>
        <h2>@Localizer["SignInTitle"]</h2>
        <p>@(Model.ShowEmailPasswordTab ? Localizer["SignInSubtitle"] : Localizer["PhoneSignInSubtitle"])</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        @if (Model.ExternalLoginError is not null)
        {
            <div class="huia-validation-summary" role="alert">@Model.ExternalLoginError</div>
        }

        @if (Model.PhoneLoginError is not null)
        {
            <div class="huia-validation-summary" role="alert">@Model.PhoneLoginError</div>
        }

        @if (hybrid)
        {
            @* No aria-labelledby here: pointing it at the tab (whose accessible name is just "Email"/
               "Phone") gives the whole panel that same accessible name via ARIA's labelling rules —
               which then collides with the "Email" field's own <label> inside it, breaking anything
               (assistive tech, Playwright's GetByLabel) that looks up an element by that name, since two
               different things now answer to "Email". role="tabpanel" + the tab's own aria-controls is
               everything Basecoat's tabs script needs; skipping the panel-to-tab name association avoids
               the collision. *@
            <div role="tabpanel" id="huia-tab-panel-password" tabindex="-1" hidden="@Model.PreferPhoneTab">
                <partial name="_EmailPasswordLoginForm" />
            </div>
            <div role="tabpanel" id="huia-tab-panel-phone" tabindex="-1" hidden="@(!Model.PreferPhoneTab)">
                <partial name="_PhoneLoginForm" />
            </div>
        }
        else if (Model.ShowEmailPasswordTab)
        {
            <partial name="_EmailPasswordLoginForm" />
        }
        else if (Model.ShowPasswordlessTab)
        {
            <partial name="_PhoneLoginForm" />
        }

        <div id="huia-login-alt-options">
            @if (Model.ExternalLogins.Count > 0)
            {
                <div class="field-separator huia-divider">
                    <hr role="separator" />
                    <span>@Localizer["OrContinueWith"]</span>
                </div>

                <div class="huia-field-group">
                    @foreach (var scheme in Model.ExternalLogins)
                    {
                        <form method="post" asp-page="./ExternalLogin" asp-route-provider="@scheme.Name" asp-route-returnUrl="@Model.ReturnUrl">
                            <button type="submit" class="btn huia-full-width" data-variant="outline">
                                <partial name="_ExternalProviderIcon" model="scheme.Name" />
                                @scheme.DisplayName
                            </button>
                        </form>
                    }
                </div>
            }

            @if (Model.ShowEmailPasswordTab)
            {
                <div class="huia-footer-links">
                    <a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl" data-variant="link" class="btn" data-size="sm">@Localizer["ForgotPasswordLink"]</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" data-variant="link" class="btn" data-size="sm">@Localizer["CreateAccountLink"]</a>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    @if (Model.ShowEmailPasswordTab)
    {
        <script src="~/_content/Huia/js/huia-login-steps.js"></script>
    }
    @if (Model.ShowPasswordlessTab)
    {
        <script src="~/_content/Huia/lib/libphonenumber-js/libphonenumber-js.min.js"
                asp-fallback-src="https://cdn.jsdelivr.net/npm/libphonenumber-js@1.13.11/bundle/libphonenumber-min.js"
                asp-fallback-test="window.libphonenumber"></script>
        <script src="~/_content/Huia/js/huia-phone-validation.js"></script>
    }
}
