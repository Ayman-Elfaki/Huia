@page
@model LoginWith2faModel
@{
    ViewData["Title"] = Localizer["TwoFactorTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["TwoFactorTitle"]</h2>
        <p>@Localizer["TwoFactorSubtitle"]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <form method="post" class="huia-field-group" novalidate>
            @* Razor omits the value attribute entirely for a plain bool expression when it's false (its
               built-in conditional-attribute-rendering rule), so an unchecked "Remember me" on the Login page
               would otherwise post rememberMe="" here — which fails to bind to OnPostAsync's bool parameter
               and silently short-circuits verification before the code is even checked. ToString() forces a
               string expression so "True"/"False" always renders, like ReturnUrl below. *@
            <input type="hidden" name="rememberMe" value="@Model.RememberMe.ToString()" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="huia-validation-summary" role="alert"></div>

            <div role="group" class="field">
                <label asp-for="Input.TwoFactorCode">@Localizer["AuthenticatorCodeLabel"]</label>
                <input asp-for="Input.TwoFactorCode" autocomplete="one-time-code" inputmode="numeric" />
                <span asp-validation-for="Input.TwoFactorCode" role="alert"></span>
            </div>

            <div role="group" class="field" data-orientation="horizontal">
                <input asp-for="Input.RememberMachine" type="checkbox" role="switch" class="input" />
                <label asp-for="Input.RememberMachine">@Localizer["RememberMachineLabel"]</label>
            </div>

            <div class="huia-actions">
                <button type="submit" class="btn huia-full-width">@Localizer["VerifyButton"]</button>
            </div>
        </form>
    </section>
</div>
