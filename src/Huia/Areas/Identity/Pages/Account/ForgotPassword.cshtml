@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["ForgotPasswordTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["ForgotPasswordTitle"]</h2>
        <p>@Localizer["ForgotPasswordSubtitle"]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <form method="post" class="huia-field-group" novalidate>
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="huia-validation-summary" role="alert"></div>

            <div role="group" class="field">
                <label asp-for="Input.Email">@Localizer["EmailLabel"]</label>
                <input asp-for="Input.Email" autocomplete="username" placeholder="m@example.com" />
                <span asp-validation-for="Input.Email" role="alert"></span>
            </div>

            <div class="huia-actions">
                <button type="submit" class="btn huia-full-width">@Localizer["SendResetLinkButton"]</button>
            </div>
        </form>

        <div class="huia-footer-links">
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" data-variant="link" class="btn" data-size="sm">@Localizer["BackToSignInLink"]</a>
        </div>
    </section>
</div>
