@using System.Text.Json
@model Huia.Endpoints.Connect.FrontChannelSignOutViewModel
@{
    // Rendered by RazorViewRenderer from EndSessionEndpoints (/connect/logout), not routed to directly — it
    // has no @page directive and isn't reachable through Huia.UI's normal Razor Pages navigation. Layout is
    // deliberately not Huia.UI's own _Layout: that layout authenticates against the Identity.Application
    // cookie to decide what chrome to show, but by the time this renders that cookie is already gone (see
    // EndSessionEndpoints.HandleAsync), and RazorViewRenderer's HttpContext is a synthetic one anyway.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Localizer["SigningOutTitle"]</title>
    <link rel="stylesheet" href="/_content/Huia/lib/basecoat/basecoat.min.css" />
    <style>
        body {
            display: grid;
            place-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .huia-signing-out-icon {
            animation: huia-spin 1s linear infinite;
        }

        @@keyframes huia-spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="dark">
    <div class="card" style="max-width: 22rem;">
        <header style="display: flex; align-items: center; gap: 0.5rem;">
            <i data-lucide="loader-circle" class="huia-signing-out-icon"></i>
            <h2>@Localizer["SigningOutTitle"]</h2>
        </header>
        <section>
            <p>@Localizer["SigningOutMessage"]</p>
        </section>
    </div>

    @* One hidden iframe per relying party that registered a front-channel logout URI — each load notifies
       that client, exactly like a visible <img> pixel would, just invisibly. *@
    @foreach (var src in Model.IframeSources)
    {
        <iframe src="@src" style="display:none" width="0" height="0"></iframe>
    }

    <script src="/_content/Huia/lib/lucide/lucide.min.js"></script>
    <script>
        if (window.lucide) lucide.createIcons();

        // Gives the iframes above a moment to actually load before navigating away — there's no reliable
        // cross-origin "all iframes finished" signal (their content lives on other clients' own origins), so
        // this is a best-effort wait rather than something that blocks on it. Re-requests /connect/logout
        // with the same end-session parameters so OpenIddict can perform its own (already-validated)
        // post_logout_redirect_uri/state redirect exactly as it would have without this interstitial.
        setTimeout(function () { window.location.replace(@Html.Raw(JsonSerializer.Serialize(Model.ContinueUrl))); }, 1500);
    </script>
</body>
</html>
