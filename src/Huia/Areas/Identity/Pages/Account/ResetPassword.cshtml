@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Localizer["ResetPasswordTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["ResetPasswordTitle"]</h2>
        <p>@Localizer["ResetPasswordSubtitle"]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <form method="post" class="huia-field-group" novalidate>
            <input asp-for="Input.Code" type="hidden" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="huia-validation-summary" role="alert"></div>

            <div role="group" class="field">
                <label asp-for="Input.Email">@Localizer["EmailLabel"]</label>
                <input asp-for="Input.Email" autocomplete="username" placeholder="m@example.com" />
                <span asp-validation-for="Input.Email" role="alert"></span>
            </div>

            <div role="group" class="field">
                <label asp-for="Input.Password">@Localizer["NewPasswordLabel"]</label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" role="alert"></span>
            </div>

            <div role="group" class="field">
                <label asp-for="Input.ConfirmPassword">@Localizer["ConfirmNewPasswordLabel"]</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" role="alert"></span>
            </div>

            <div class="huia-actions">
                <button type="submit" class="btn huia-full-width">@Localizer["ResetPasswordButton"]</button>
            </div>
        </form>
    </section>
</div>
