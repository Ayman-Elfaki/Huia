@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["PasswordResetTitle"].Value;
}

<div class="card">
    <header>
        <h2>@Localizer["PasswordResetTitle"]</h2>
        <p>@Localizer["PasswordResetMessage"]</p>
        <div class="card-action">
            <partial name="_ThemeSwitch" />
        </div>
    </header>
    <section>
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn huia-full-width" data-variant="outline">@Localizer["SignInLink"]</a>
    </section>
</div>
