{
  "name": "nuxt-huia-headless",
  "version": "1.0.0-alpha.1",
  "description": "Nuxt 4 Headless bearer-token authentication module for the Huia identity provider",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayman-Elfaki/Huia.git",
    "directory": "src/nuxt-headless"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.13.0",
    "iron-webcrypto": "^1.2.1",
    "uncrypto": "^0.1.3"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^22.10.0",
    "nuxt": "^4.0.0",
    "typescript": "~5.9.3",
    "unstorage": "^1.12.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
