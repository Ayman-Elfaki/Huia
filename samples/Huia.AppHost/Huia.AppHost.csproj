<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>f3c75c5f-49bc-4f4a-a700-4f1f6d68367a</UserSecretsId>
        <!-- AddNextJsApp is experimental in this Aspire release. -->
        <NoWarn>$(NoWarn);ASPIREJAVASCRIPT001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost"/>
        <PackageReference Include="Aspire.Hosting.JavaScript"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Huia.IdentityServer\Huia.IdentityServer.csproj" />
        <ProjectReference Include="..\Huia.TodoApi\Huia.TodoApi.csproj" />
    </ItemGroup>

</Project>
