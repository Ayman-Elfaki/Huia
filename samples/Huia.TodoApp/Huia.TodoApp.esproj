<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.4110890">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <StartupCommand>npm run dev</StartupCommand>
        <!-- Aspire's AddNextJsApp runs/builds this app itself (see samples/Huia.AppHost/Program.cs); this
             project file exists only so the app shows up in Huia.slnx/the IDE with JS tooling support. -->
        <ShouldRunBuildScript>false</ShouldRunBuildScript>
        <BuildOutputFolder>$(MSBuildProjectDirectory)\.next</BuildOutputFolder>
        <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
        <BuildCommand></BuildCommand>
        <TestCommand></TestCommand>
        <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    </PropertyGroup>


</Project>
