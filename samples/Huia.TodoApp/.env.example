# Copy to .env.local for standalone `npm run dev` (outside the Aspire AppHost, which injects all of these
# itself). Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
# Without this, Auth.js has to infer its own base URL from the request (host/proto headers) and logs a
# "NEXTAUTH_URL" warning on every request doing so — see https://next-auth.js.org/warnings#nextauth_url.
NEXTAUTH_URL=http://localhost:3000
# Backs the session store (see @/lib/session-store.ts) — a local Redis instance for standalone dev; the
# Aspire AppHost injects its own "cache" resource's connection string instead (see AppHost.cs).
CACHE_URI=redis://localhost:6379
# Trailing slash matters: OpenIddict's discovery document reports the issuer via a bare .NET Uri, which
# normalizes to "https://localhost:5041/", and Auth.js validates against this with strict string equality.
AUTH_HUIA_ISSUER=https://localhost:5041/
AUTH_HUIA_CLIENT_ID=todo-web
AUTH_HUIA_CLIENT_SECRET=todo-web-dev-secret
# Where Huia sends the browser back after RP-initiated logout (/connect/logout) clears its own cookie.
AUTH_HUIA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
TODO_API_URL=https://localhost:5041
