root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.{js,mjs,cjs,ts,mts,cts,tsx,vue,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
# 'var'
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
# Expression preferences
csharp_prefer_braces = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
# Docs required on public API in src/ (enforced via TreatWarningsAsErrors + GenerateDocumentationFile)
dotnet_diagnostic.CS1591.severity = warning

# Generated EF Core migrations (also covers the migrations folder in the sample host)
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
dotnet_analyzer_diagnostic.severity = none

# Test projects: relax doc + some analyzer noise
[tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none

# Samples: relax doc requirement
[samples/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
